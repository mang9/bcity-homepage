{
  "name": "bcity-homepage",
  "version": "1.0.0",
  "private": true,
  "description": "춘천기업혁신파크 B-CITY 마케팅 홈페이지 — 번들러 없는 정적 사이트 + Tailwind CLI",
  "scripts": {
    "build": "npm run build:css && npm run build:pages",
    "build:css": "tailwindcss -i src/css/app.css -o assets/css/app.css --minify",
    "build:pages": "node tools/build/pages.mjs",
    "build:check": "node tools/build/pages.mjs --check && node tools/build/lint-classes.mjs",
    "dev": "tailwindcss -i src/css/app.css -o assets/css/app.css --watch",
    "build:pretty": "tailwindcss -i src/css/app.css -o assets/css/app.css",
    "lint:classes": "node tools/build/lint-classes.mjs"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.1.11"
  }
}
